@inherits LayoutComponentBase
@implements IDisposable
@inject ContentService Content
@inject LanguageService Lang
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PWAUpdater Text="@Content.Ui(Constants.Ui.Pwa.UpdateText)"
            ButtonCaption="@Content.Ui(Constants.Ui.Pwa.UpdateButton)" />

<div class="cp-app">
    <a class="cp-skip" href="@($"{Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]}#{Constants.Sections.Main}")">@Content.Ui(Constants.Ui.Nav.Skip)</a>
    <SiteHeader />
    <main id="@Constants.Sections.Main" class="cp-main" @key="Lang.Current">
        @Body
    </main>
    <SiteFooter />
</div>

<FluentProviders />

@code {
    private string? _documentLanguage;

    protected override void OnInitialized()
    {
        Lang.Changed += OnLanguageChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync(Constants.Js.Started);

        if (_documentLanguage != Lang.Current)
        {
            _documentLanguage = Lang.Current;
            await JS.InvokeVoidAsync(Constants.Js.SetDocumentLanguage, Lang.Current);
        }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Same-page anchors (#section) scroll by themselves.
        if (e.Location.Contains('#'))
            return;

        try
        {
            await JS.InvokeVoidAsync(Constants.Js.ScrollToTop);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public void Dispose()
    {
        Lang.Changed -= OnLanguageChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
