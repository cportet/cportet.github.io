@inherits LayoutComponentBase
@implements IDisposable
@inject ContentService Content
@inject LanguageService Lang
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PWAUpdater Text="@Content.Ui("pwa.updateText")"
            ButtonCaption="@Content.Ui("pwa.updateButton")" />

<div class="cp-app">
    <a class="cp-skip" href="@($"{Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]}#main")">@(Lang.IsEnglish ? "Skip to content" : "Aller au contenu")</a>
    <SiteHeader />
    <main id="main" class="cp-main" @key="Lang.Current">
        @Body
    </main>
    <SiteFooter />
</div>

<FluentProviders />

@code {
    private string? _documentLanguage;

    protected override void OnInitialized()
    {
        Lang.Changed += OnLanguageChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("cp.started");

        if (_documentLanguage != Lang.Current)
        {
            _documentLanguage = Lang.Current;
            await JS.InvokeVoidAsync("cp.setDocumentLanguage", Lang.Current);
        }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Same-page anchors (#section) scroll by themselves.
        if (e.Location.Contains('#'))
            return;

        try
        {
            await JS.InvokeVoidAsync("cp.scrollToTop");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public void Dispose()
    {
        Lang.Changed -= OnLanguageChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
