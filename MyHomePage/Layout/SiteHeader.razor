@implements IDisposable
@inject NavigationManager Navigation
@inject ThemePreferences Theme
@inject IJSRuntime JS

<header class="cp-header">
    <div class="cp-container cp-header__inner">
        <a class="cp-brand" href="@Href(Constants.Pages.Home.Path)">
            <span class="cp-brand__badge" aria-hidden="true">@Content.Site.Initials</span>
            @Content.Site.Name
        </a>

        <nav id="cp-nav" class="cp-nav @(_menuOpen ? "cp-nav--open" : null)" aria-label="@Ui(Constants.Ui.Nav.Main)">
            @foreach (var item in Content.Site.Nav)
            {
                <NavLink class="cp-nav__link" href="@Href(item.Path)"
                         Match="@(item.Path == Constants.Pages.Home.Route ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         @onclick="CloseMenu">@T(item.Label)</NavLink>
            }

            @* Mobile menu only: direct access to the family and favourite sites. *@
            <div class="cp-nav__extra">
                <p class="cp-overline">@Ui(Constants.Ui.Nav.Featured)</p>
                @foreach (var site in Content.Perso.Featured.Where(s => s.Url is not null))
                {
                    <a class="cp-nav__link" href="@site.Url" target="_blank" rel="noopener">
                        @site.Title <CpIcon Value="@(Constants.Icons.Small.Open)" />
                    </a>
                }
                <p class="cp-overline">@Ui(Constants.Ui.Nav.Family)</p>
                @foreach (var site in Content.Perso.Family)
                {
                    <a class="cp-nav__link" href="@site.Url" target="_blank" rel="noopener">
                        @site.Name <CpIcon Value="@(Constants.Icons.Small.Open)" />
                    </a>
                }

                @* On phones, the language and install buttons live in the menu. *@
                <p class="cp-overline">@Ui(Constants.Ui.Nav.LanguageGroup)</p>
                <div class="cp-nav__tools">
                    @LanguageSwitch
                    @if (_canInstall)
                    {
                        <button type="button" class="cp-btn" @onclick="InstallAsync">
                            <CpIcon Value="@(Constants.Icons.Regular.Download)" />
                            @Ui(Constants.Ui.Pwa.Install)
                        </button>
                    }
                </div>
                <a class="cp-nav__link" href="@Href(Constants.Pages.Preferences.Path)" @onclick="CloseMenu">
                    <CpIcon Value="@(Constants.Icons.Regular.Settings)" />
                    @Ui(Constants.Ui.Nav.Preferences)
                </a>
                <p class="cp-version cp-nav__version">@string.Format(Ui(Constants.Ui.App.Version), Content.Config.Version)</p>
            </div>
        </nav>

        <div class="cp-header__tools">
            <div class="cp-header__wide-only">
                @LanguageSwitch
                @if (_canInstall)
                {
                    <button type="button" class="cp-iconbtn" title="@Ui(Constants.Ui.Pwa.Install)" aria-label="@Ui(Constants.Ui.Pwa.Install)" @onclick="InstallAsync">
                        <CpIcon Value="@(Constants.Icons.Regular.Download)" />
                    </button>
                }
            </div>

            <button type="button" class="cp-iconbtn" @onclick="ToggleThemeAsync"
                    title="@ThemeLabel" aria-label="@ThemeLabel">
                @if (_dark)
                {
                    <CpIcon Value="@(Constants.Icons.Regular.Sun)" />
                }
                else
                {
                    <CpIcon Value="@(Constants.Icons.Regular.Moon)" />
                }
            </button>

            <button type="button" class="cp-iconbtn cp-header__menu" @onclick="ToggleMenu"
                    aria-controls="cp-nav" aria-expanded="@(_menuOpen ? "true" : "false")"
                    aria-label="@Ui(_menuOpen ? Constants.Ui.Nav.Close : Constants.Ui.Nav.Open)">
                @if (_menuOpen)
                {
                    <CpIcon Value="@(Constants.Icons.Large.Close)" />
                }
                else
                {
                    <CpIcon Value="@(Constants.Icons.Large.Menu)" />
                }
            </button>
        </div>
    </div>
</header>

@code {
    private bool _menuOpen;
    private bool _dark;
    private bool _canInstall;

    private RenderFragment LanguageSwitch => @<div class="cp-segmented" role="group" aria-label="@Ui(Constants.Ui.Nav.LanguageGroup)">
        <a href="@Lang.Switch(Languages.French)" hreflang="fr" lang="fr"
           aria-current="@(Lang.IsEnglish ? null : "true")" @onclick="CloseMenu">FR</a>
        <a href="@Lang.Switch(Languages.English)" hreflang="en" lang="en"
           aria-current="@(Lang.IsEnglish ? "true" : null)" @onclick="CloseMenu">EN</a>
    </div>;

    private string ThemeLabel => Ui(_dark ? Constants.Ui.Theme.ToLight : Constants.Ui.Theme.ToDark);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Theme.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dark = await Theme.IsDarkAsync();
        _canInstall = await JS.InvokeAsync<bool>(Constants.Js.Pwa.CanInstall);
        StateHasChanged();
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private async Task ToggleThemeAsync() => await Theme.ToggleDarkAsync();

    private async Task InstallAsync()
    {
        await JS.InvokeAsync<bool>(Constants.Js.Pwa.Install);
        _canInstall = await JS.InvokeAsync<bool>(Constants.Js.Pwa.CanInstall);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _menuOpen = false;
        try
        {
            _canInstall = await JS.InvokeAsync<bool>(Constants.Js.Pwa.CanInstall);
        }
        catch (JSDisconnectedException)
        {
        }
        await InvokeAsync(StateHasChanged);
    }

    private async void OnThemeChanged()
    {
        _dark = await Theme.IsDarkAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Theme.Changed -= OnThemeChanged;
    }
}
