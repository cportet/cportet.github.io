@attribute [Route(Constants.Pages.File.Route)]
@attribute [Route(Constants.Pages.File.Aliases.Fichier)]
@inject NavigationManager Navigation

@* Former document viewer: old links now open the document directly. *@

@code {
    [Parameter]
    public string? Kind { get; set; }

    protected override void OnParametersSet()
    {
        var target = Kind?.Trim().ToLowerInvariant() == Constants.Pages.File.CvKind ? Content.Site.CvPdf : Href(Constants.Pages.NotFound.Path);
        Navigation.NavigateTo(target, forceLoad: target == Content.Site.CvPdf, replace: true);
    }
}
