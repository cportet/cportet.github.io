@attribute [Route(Constants.Pages.Resume.Route)]
@attribute [Route(Constants.Pages.Resume.RouteEn)]
@attribute [Route(Constants.Pages.Resume.Aliases.Cv)]
@attribute [Route(Constants.Pages.Resume.Aliases.CurriculumVitae)]
@attribute [Route(Constants.Pages.Resume.Aliases.Experience)]

<Seo Page="@Constants.Pages.Resume.Key" Path="@Constants.Pages.Resume.Path" />
<HeadContent>
    <link rel="alternate" type="application/pdf" href="@(Content.Site.BaseUrl + Content.Site.CvPdf)" />
</HeadContent>

<div class="cp-container">
    <section class="cp-resume-header">
        <ZoomImage Class="cp-portrait cp-portrait--small" Src="@Constants.Files.ResumePortrait" Alt="@T(Content.Profile.Portrait.Alt)" Width="128" Height="128" />
        <div class="cp-resume-header__text">
            <p class="cp-eyebrow">@T(Content.Page(Constants.Pages.Resume.Key).Eyebrow)</p>
            <h1 class="cp-display">@Content.Site.Name</h1>
            <p class="cp-lead">@T(Content.Profile.Role)</p>
        </div>
        <div class="cp-actions">
            <a class="cp-btn cp-btn--primary" href="@Content.Site.CvPdf" target="_blank" rel="noopener">
                <CpIcon Value="@(Constants.Icons.Regular.Download)" />
                @Ui(Constants.Ui.Cta.DownloadPdf)
            </a>
            <a class="cp-btn cp-btn--subtle" href="@Content.Site.LinkedIn" target="_blank" rel="noopener">
                @Ui(Constants.Ui.Cta.LinkedIn)
                <CpIcon Value="@(Constants.Icons.Small.Open)" />
            </a>
        </div>
    </section>

    <nav class="cp-anchors" aria-label="@Ui(Constants.Ui.Resume.Sections)">
        <a href="@Anchor(Constants.Sections.Resume.Profile)">@Ui(Constants.Ui.Resume.Profile)</a>
        <a href="@Anchor(Constants.Sections.Resume.Experience)">@Ui(Constants.Ui.Resume.Experience)</a>
        <a href="@Anchor(Constants.Sections.Resume.Skills)">@Ui(Constants.Ui.Resume.Skills)</a>
        <a href="@Anchor(Constants.Sections.Resume.Trainings)">@Ui(Constants.Ui.Resume.TrainingsShort)</a>
        <a href="@Anchor(Constants.Sections.Resume.Education)">@Ui(Constants.Ui.Resume.Education)</a>
    </nav>

    <div class="cp-split">
        <div class="cp-split__main">
            <section id="@Constants.Sections.Resume.Profile" class="cp-block">
                <h2 class="cp-h2">@Ui(Constants.Ui.Resume.Profile)</h2>
                <Markdown Path="@Constants.Files.Markdown.ResumeProfile" Class="cp-prose--lead" />
            </section>

            <section id="@Constants.Sections.Resume.Experience" class="cp-block">
                <h2 class="cp-h2">@Ui(Constants.Ui.Resume.Experience)</h2>
                @foreach (var experience in Content.Experiences)
                {
                    <article class="cp-experience">
                        <div class="cp-experience__head">
                            <h3 class="cp-h3">@T(experience.Role)</h3>
                            <span class="cp-muted cp-nums">@Content.Period(experience)</span>
                        </div>
                        <div class="cp-muted">
                            @if (experience.Url is not null)
                            {
                                <a class="cp-link" href="@experience.Url" target="_blank" rel="noopener">@experience.Company</a>
                            }
                            else
                            {
                                <strong class="cp-strong">@experience.Company</strong>
                            }
                            · @T(experience.Location) · @Content.Duration(experience)
                        </div>
                        @foreach (var paragraph in experience.Details)
                        {
                            <p class="cp-muted">@T(paragraph)</p>
                        }
                        <div class="cp-tags">
                            @foreach (var tag in experience.Tags)
                            {
                                <Tag Text="@T(tag)" />
                            }
                        </div>
                    </article>
                }

                <article class="cp-experience">
                    <div class="cp-experience__head">
                        <h3 class="cp-h3">@Ui(Constants.Ui.Resume.Others)</h3>
                        <span class="cp-muted cp-nums">@T(Data.Others.Period)</span>
                    </div>
                    <p class="cp-muted">@T(Data.Others.Intro)</p>
                    <ul class="cp-list">
                        @foreach (var other in Data.Others.Items)
                        {
                            <li>
                                <a class="cp-link cp-strong" href="@other.Url" target="_blank" rel="noopener">@other.Company</a>
                                · @T(other.Location) — @T(other.Role)
                            </li>
                        }
                    </ul>
                </article>
            </section>

            <section id="@Constants.Sections.Resume.Education" class="cp-block">
                <h2 class="cp-h2">@Ui(Constants.Ui.Resume.Education)</h2>
                @foreach (var education in Data.Education)
                {
                    <div class="cp-experience__head">
                        <h3 class="cp-h3">@T(education.Title)</h3>
                        <span class="cp-muted cp-nums">@education.Year</span>
                    </div>
                    <p class="cp-muted">@T(education.Text)</p>
                }
            </section>
        </div>

        <aside class="cp-split__aside">
            <div class="cp-card cp-card--padded">
                <h2 class="cp-h4">@Ui(Constants.Ui.Resume.Facts)</h2>
                <dl class="cp-dl">
                    @foreach (var fact in Data.Facts)
                    {
                        <dt>@T(fact.Label)</dt>
                        <dd class="@(fact.Highlight ? "cp-accent-text" : null)">@T(fact.Value)</dd>
                    }
                </dl>
            </div>

            <div id="@Constants.Sections.Resume.Skills" class="cp-card cp-card--padded">
                <h2 class="cp-h4">@Ui(Constants.Ui.Resume.Skills)</h2>
                @foreach (var group in Data.Skills)
                {
                    <div class="cp-skill-group">
                        <h3 class="cp-overline">@T(group.Label)</h3>
                        <div class="cp-tags">
                            @foreach (var skill in group.Items)
                            {
                                <Tag Text="@T(skill)" Outline="true" />
                            }
                        </div>
                    </div>
                }
            </div>

            <div id="@Constants.Sections.Resume.Trainings" class="cp-card cp-card--padded">
                <h2 class="cp-h4">@Ui(Constants.Ui.Resume.Trainings)</h2>
                <ul class="cp-years">
                    @foreach (var training in Data.Trainings)
                    {
                        <li><span class="cp-years__year">@training.Year</span><span>@T(training.Label)</span></li>
                    }
                </ul>
                @if (Data.TrainingsNote is not null)
                {
                    <p class="cp-muted cp-small">@T(Data.TrainingsNote)</p>
                }
            </div>

            <div class="cp-card cp-card--padded">
                <h2 class="cp-h4">@Ui(Constants.Ui.Resume.Interests)</h2>
                <p class="cp-muted">@T(Data.Interests)</p>
            </div>
        </aside>
    </div>
</div>

@code {
    private ResumeData Data => Content.Resume;

    private string Anchor(string id) => $"{Href(Constants.Pages.Resume.Path)}#{id}";
}
