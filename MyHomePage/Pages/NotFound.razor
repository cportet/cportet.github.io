@page "/404"
@page "/en/404"
@layout MainLayout

<Seo Page="notFound" Path="404" />
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="cp-container cp-not-found">
    <img src="/img/404.png" alt="" width="280" height="280" />
    <PageHeader Page="notFound">
        <div class="cp-actions">
            <a class="cp-btn cp-btn--primary" href="@Href("/")">@Ui("notFound.home")</a>
            <a class="cp-btn" href="javascript:history.back()">@Ui("notFound.back")</a>
        </div>
    </PageHeader>
</div>
