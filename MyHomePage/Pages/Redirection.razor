@page "/redirection"
@page "/redir"
@inject NavigationManager Navigation

@* Target of wwwroot/404.html: GitHub Pages serves it for deep links, and it sends them back here. *@
<div class="cp-container cp-section">
    <p class="cp-muted">@Ui("redirect.text")</p>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Path { get; set; }

    protected override void OnParametersSet()
    {
        var target = string.IsNullOrWhiteSpace(Path) ? "/" : Uri.UnescapeDataString(Path);

        // Only local paths: never redirect to another site.
        if (!target.StartsWith('/') || target.StartsWith("//"))
            target = "/";

        Navigation.NavigateTo(target, replace: true);
    }
}
