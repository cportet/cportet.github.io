@page "/perso"
@page "/en/perso"

<Seo Page="perso" Path="perso" />

<div class="cp-container">
    <section class="cp-hero cp-hero--compact">
        <div class="cp-hero__text">
            <p class="cp-eyebrow">@T(Meta.Eyebrow)</p>
            <h1 class="cp-display">@T(Meta.Heading)</h1>
            <Markdown Path="perso/intro" Class="cp-prose--lead" />
        </div>
        <figure class="cp-figure">
            <img src="@Data.Photo.Url" alt="@T(Data.Photo.Alt)" width="480" height="360" />
            @if (Data.Photo.Caption is not null)
            {
                <figcaption>@T(Data.Photo.Caption)</figcaption>
            }
        </figure>
    </section>

    <section class="cp-section">
        <h2 class="cp-h2">@Ui("perso.family")</h2>
        <div class="cp-grid">
            @foreach (var site in Data.Family)
            {
                <a class="cp-card cp-person" href="@site.Url" target="_blank" rel="noopener">
                    <span class="cp-person__initial" aria-hidden="true">@site.Name[..1]</span>
                    <span class="cp-person__text">
                        <span class="cp-person__name">@site.Name</span>
                        <span class="cp-muted cp-small">@(new Uri(site.Url).Host)</span>
                    </span>
                    <CpIcon Value="@(new Icons.Regular.Size20.Open())" Class="cp-accent-text" />
                </a>
            }
        </div>
    </section>

    @if (Data.Featured.Count > 0)
    {
        <section class="cp-band cp-section">
            <div class="cp-band__intro">
                <h2 class="cp-h2">@Ui("perso.featured")</h2>
                <p>@Ui("perso.featuredLead")</p>
            </div>
            <div class="cp-grid cp-grid--wide">
                @foreach (var site in Data.Featured)
                {
                    <article class="cp-card cp-card--padded cp-card--raised">
                        <p class="cp-overline">@T(site.Kind)</p>
                        <h3 class="cp-h3">@site.Title</h3>
                        <p class="cp-muted cp-grow">@T(site.Summary)</p>
                        @if (site.Url is not null)
                        {
                            <a class="cp-link cp-inline" href="@site.Url" target="_blank" rel="noopener">
                                @(new Uri(site.Url).Host)
                                <CpIcon Value="@(new Icons.Regular.Size16.Open())" Size="16" />
                            </a>
                        }
                    </article>
                }
            </div>
        </section>
    }

    <section class="cp-findme">
        <h2 class="cp-h4">@Ui("perso.findMe")</h2>
        <div class="cp-pills">
            @foreach (var social in Content.Site.Socials)
            {
                <a class="cp-pill" href="@social.Url" target="_blank" rel="noopener">@social.Name</a>
            }
        </div>
        <a class="cp-link" href="@Href("contact")">@Ui("perso.byEmail")</a>
    </section>
</div>

@code {
    private PersoData Data => Content.Perso;

    private PageMeta Meta => Content.Page("perso");
}
