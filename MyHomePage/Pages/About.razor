@page "/about"
@page "/en/about"
@page "/apropos"
@inject IJSRuntime JS

<Seo Page="about" Path="about" />

<div class="cp-container">
    <PageHeader Page="about" />

    <div class="cp-grid cp-grid--wide">
        @foreach (var section in Content.About.Sections)
        {
            <section class="cp-card cp-card--padded">
                <h2 class="cp-h3">@T(section.Title)</h2>
                @if (section.Text is not null)
                {
                    <p class="cp-muted">@T(section.Text)</p>
                }
                @if (section.Items.Count > 0)
                {
                    @if (section.Items.All(i => i.Label is not null && i.Url is null))
                    {
                        <dl class="cp-dl">
                            @foreach (var item in section.Items)
                            {
                                <dt>@T(item.Label)</dt>
                                <dd>@T(item.Text)</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <ul class="cp-list">
                            @foreach (var item in section.Items)
                            {
                                <li>
                                    @if (item.Url is not null)
                                    {
                                        <a class="cp-link" href="@item.Url" target="_blank" rel="noopener">@T(item.Label)</a>
                                        <span> — @T(item.Text)</span>
                                    }
                                    else
                                    {
                                        @T(item.Text)
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
                @if (section.Link is not null)
                {
                    <a class="cp-link" href="@section.Link.Url" target="_blank" rel="noopener">@T(section.Link.Label)</a>
                }
            </section>
        }

        <section class="cp-card cp-card--padded">
            <h2 class="cp-h3">@Ui("about.app.title")</h2>
            <p class="cp-muted">@string.Format(Ui("about.app.text"), Content.Config.Version)</p>
            @if (_installMessage is not null)
            {
                <p class="cp-muted cp-small">@_installMessage</p>
            }
            <div class="cp-actions">
                <button type="button" class="cp-btn cp-btn--primary" @onclick="InstallAsync">
                    <CpIcon Value="@(new Icons.Regular.Size20.ArrowDownload())" />
                    @Ui("about.app.install")
                </button>
                <a class="cp-btn" href="@Href("preferences")">@Ui("about.app.preferences")</a>
            </div>
        </section>
    </div>

    <p class="cp-section cp-muted">@((MarkupString)Ui("about.support"))</p>
</div>

@code {
    private string? _installMessage;

    private async Task InstallAsync()
    {
        var installed = await JS.InvokeAsync<bool>("cp.pwa.install");
        _installMessage = installed ? null : Ui("about.app.installed");
    }
}
