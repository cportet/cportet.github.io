@attribute [Route(Constants.Pages.About.Route)]
@attribute [Route(Constants.Pages.About.RouteEn)]
@attribute [Route(Constants.Pages.About.Aliases.APropos)]
@inject IJSRuntime JS

<Seo Page="@Constants.Pages.About.Key" Path="@Constants.Pages.About.Path" />

<div class="cp-container">
    <PageHeader Page="@Constants.Pages.About.Key" />

    <div class="cp-grid cp-grid--wide">
        @foreach (var section in Content.About.Sections)
        {
            <section class="cp-card cp-card--padded">
                <h2 class="cp-h3">@T(section.Title)</h2>
                @if (section.Text is not null)
                {
                    <p class="cp-muted">@T(section.Text)</p>
                }
                @if (section.Items.Count > 0)
                {
                    @if (section.Items.All(i => i.Label is not null && i.Url is null))
                    {
                        <dl class="cp-dl">
                            @foreach (var item in section.Items)
                            {
                                <dt>@T(item.Label)</dt>
                                <dd>@T(item.Text)</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <ul class="cp-list">
                            @foreach (var item in section.Items)
                            {
                                <li>
                                    @if (item.Url is not null)
                                    {
                                        <a class="cp-link" href="@item.Url" target="_blank" rel="noopener">@T(item.Label)</a>
                                        <span> — @T(item.Text)</span>
                                    }
                                    else
                                    {
                                        @T(item.Text)
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
                @if (section.Link is not null)
                {
                    <a class="cp-link" href="@section.Link.Url" target="_blank" rel="noopener">@T(section.Link.Label)</a>
                }
            </section>
        }

        <section class="cp-card cp-card--padded">
            <h2 class="cp-h3">@Ui(Constants.Ui.About.App.Title)</h2>
            <p class="cp-muted">@string.Format(Ui(Constants.Ui.About.App.Text), Content.Config.Version)</p>
            @if (_installMessage is not null)
            {
                <p class="cp-muted cp-small">@_installMessage</p>
            }
            <div class="cp-actions">
                <button type="button" class="cp-btn cp-btn--primary" @onclick="InstallAsync">
                    <CpIcon Value="@(Constants.Icons.Regular.Download)" />
                    @Ui(Constants.Ui.About.App.Install)
                </button>
                <a class="cp-btn" href="@Href(Constants.Pages.Preferences.Path)">@Ui(Constants.Ui.About.App.Preferences)</a>
            </div>
        </section>
    </div>

    <p class="cp-section cp-muted">@((MarkupString)Ui(Constants.Ui.About.Support))</p>
</div>

@code {
    private string? _installMessage;

    private async Task InstallAsync()
    {
        var installed = await JS.InvokeAsync<bool>(Constants.Js.Pwa.Install);
        _installMessage = installed ? null : Ui(Constants.Ui.About.App.Installed);
    }
}
