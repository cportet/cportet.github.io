@page "/projects"
@page "/en/projects"
@page "/projets"
@page "/applications"
@page "/applications/mesapps"

<Seo Page="projects" Path="projects" />

<div class="cp-container">
    <PageHeader Page="projects" />

    <section class="cp-stack">
        @foreach (var app in Data.Apps)
        {
            <article class="cp-card cp-card--padded cp-app-card">
                <div class="cp-app-card__icon" aria-hidden="true">
                    <CpIcon Value="@(new Icons.Regular.Size48.Apps())" Size="44" />
                </div>
                <div class="cp-app-card__body">
                    <div class="cp-inline">
                        <h2 class="cp-h2 cp-h2--card">@app.Name</h2>
                        @if (app.Status is not null)
                        {
                            <span class="cp-badge cp-badge--warning">@T(app.Status)</span>
                        }
                    </div>
                    @foreach (var paragraph in app.Description)
                    {
                        <p class="cp-muted">@T(paragraph)</p>
                    }
                    <div class="cp-tags">
                        @foreach (var tag in app.Tags)
                        {
                            <Tag Text="@tag" />
                        }
                    </div>
                    <div class="cp-actions">
                        @if (app.StoreUrl is not null)
                        {
                            <a class="cp-btn cp-btn--primary" href="@app.StoreUrl" target="_blank" rel="noopener">
                                @Ui("projects.store")
                                <CpIcon Value="@(new Icons.Regular.Size16.Open())" Size="16" />
                            </a>
                        }
                        <a class="cp-btn" href="@Href("projects/privacy")">@Ui("projects.privacy")</a>
                    </div>
                </div>
            </article>
        }

        <div class="cp-cards">
            @foreach (var card in Data.Cards)
            {
                <article class="cp-card cp-card--padded">
                    <h2 class="cp-h3">@T(card.Title)</h2>
                    <p class="cp-muted">@T(card.Text)</p>
                    <a class="cp-link" href="@card.Link.Url" target="_blank" rel="noopener">@T(card.Link.Label)</a>
                </article>
            }
        </div>
    </section>

    <section class="cp-band cp-band--split cp-section">
        <div class="cp-band__intro">
            <h2 class="cp-h3">@Ui("projects.privacyTitle")</h2>
            <p>@string.Format(Ui("projects.privacyUpdated"), Data.Privacy.Updated.ToString("d MMMM yyyy", Lang.Culture))</p>
            <a class="cp-link cp-link--strong" href="@Href("projects/privacy")">@Ui("projects.privacyRead")</a>
        </div>
        <ul class="cp-checks">
            @foreach (var point in Data.Privacy.Points)
            {
                <li>
                    <CpIcon Value="@(new Icons.Regular.Size20.Checkmark())" Class="cp-accent-text" />
                    <span>@T(point)</span>
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private ProjectsData Data => Content.Projects;
}
