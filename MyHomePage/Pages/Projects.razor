@attribute [Route(Constants.Pages.Projects.Route)]
@attribute [Route(Constants.Pages.Projects.RouteEn)]
@attribute [Route(Constants.Pages.Projects.Aliases.Projets)]
@attribute [Route(Constants.Pages.Projects.Aliases.Applications)]
@attribute [Route(Constants.Pages.Projects.Aliases.MesApps)]

<Seo Page="@Constants.Pages.Projects.Key" Path="@Constants.Pages.Projects.Path" />

<div class="cp-container">
    <PageHeader Page="@Constants.Pages.Projects.Key" />

    <section class="cp-stack">
        @foreach (var app in Data.Apps)
        {
            <article class="cp-card cp-card--padded cp-app-card">
                <div class="cp-app-card__icon" aria-hidden="true">
                    <CpIcon Value="@(Constants.Icons.Huge.App)" />
                </div>
                <div class="cp-app-card__body">
                    <div class="cp-inline">
                        <h2 class="cp-h2 cp-h2--card">@app.Name</h2>
                        @if (app.Status is not null)
                        {
                            <span class="cp-badge cp-badge--warning">@T(app.Status)</span>
                        }
                    </div>
                    @foreach (var paragraph in app.Description)
                    {
                        <p class="cp-muted">@T(paragraph)</p>
                    }
                    <div class="cp-tags">
                        @foreach (var tag in app.Tags)
                        {
                            <Tag Text="@tag" />
                        }
                    </div>
                    <div class="cp-actions">
                        @if (app.StoreUrl is not null)
                        {
                            <a class="cp-btn cp-btn--primary" href="@app.StoreUrl" target="_blank" rel="noopener">
                                @Ui(Constants.Ui.Projects.Store)
                                <CpIcon Value="@(Constants.Icons.Small.Open)" />
                            </a>
                        }
                        <a class="cp-btn" href="@Href(Constants.Pages.Privacy.Path)">@Ui(Constants.Ui.Projects.Privacy)</a>
                    </div>
                </div>
            </article>
        }

        <div class="cp-cards">
            @foreach (var card in Data.Cards)
            {
                <article class="cp-card cp-card--padded">
                    <h2 class="cp-h3">@T(card.Title)</h2>
                    <p class="cp-muted">@T(card.Text)</p>
                    <a class="cp-link" href="@card.Link.Url" target="_blank" rel="noopener">@T(card.Link.Label)</a>
                </article>
            }
        </div>
    </section>

    <section class="cp-band cp-band--split cp-section">
        <div class="cp-band__intro">
            <h2 class="cp-h3">@Ui(Constants.Ui.Projects.PrivacyTitle)</h2>
            <p>@string.Format(Ui(Constants.Ui.Projects.PrivacyUpdated), Data.Privacy.Updated.ToString(Constants.Formats.LongDate, Lang.Culture))</p>
            <a class="cp-link cp-link--strong" href="@Href(Constants.Pages.Privacy.Path)">@Ui(Constants.Ui.Projects.PrivacyRead)</a>
        </div>
        <ul class="cp-checks">
            @foreach (var point in Data.Privacy.Points)
            {
                <li>
                    <CpIcon Value="@(Constants.Icons.Regular.Checkmark)" Class="cp-accent-text" />
                    <span>@T(point)</span>
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private ProjectsData Data => Content.Projects;
}
